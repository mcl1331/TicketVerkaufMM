@model TicketverkaufMM.ViewModels.ReservierungCreateViewModel

@{
    ViewData["Title"] = "Reservierung erstellen";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="card-title mb-4">🎟️ Reservierung erstellen</h2>

                <form asp-action="Create" method="post">

                    <div class="mb-3">
                        <label asp-for="Personenanzahl" class="form-label fw-semibold"></label>
                        <input asp-for="Personenanzahl" class="form-control" />
                        <span asp-validation-for="Personenanzahl" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TischId" class="form-label fw-semibold"></label>
                        <select asp-for="TischId" class="form-select">
                            <option value="">-- Tisch auswählen --</option>
                            <option value="1">Tisch 1</option>
                            <option value="2">Tisch 2</option>
                            <option value="3">Tisch 3</option>
                            <option value="4">Tisch 4</option>
                        </select>
                        <span asp-validation-for="TischId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EventName" class="form-label fw-semibold"></label>
                        <input asp-for="EventName" class="form-control" placeholder="z.B. Rock Night" />
                        <span asp-validation-for="EventName" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Datum" class="form-label fw-semibold"></label>
                        <input asp-for="Datum" type="date" class="form-control" />
                        <span asp-validation-for="Datum" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Speichern</button>
                        <a asp-action="Index" class="btn btn-secondary px-4">Zurück</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}