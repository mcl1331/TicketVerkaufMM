@model IEnumerable<TicketverkaufMM.Models.Reservierung>

@{
    ViewData["Title"] = "Reservierungen";
}

<div class="ticket-bg p-4 rounded-3 mt-3">
    <div class="d-flex justify-content-between align-items-center my-4">
        <h1>Reservierungen</h1>
        <a asp-action="Create" class="btn btn-primary">+ Neue Reservierung</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Datum</th>
                <th>Eventname</th>
                <th>Tisch</th>
                <th>Personen</th>
                <th>Aktionen</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Noch keine Reservierungen vorhanden.</td>
                </tr>
            }
            else
            {
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Datum.ToString("dd.MM.yyyy")</td>
                        <td>@r.EventName</td>
                        <td>Tisch @r.TischId</td>
                        <td>@r.Personenanzahl</td>
                        <td>
                            <a href="#" class="btn btn-sm btn-outline-primary">Details</a>
                            <a href="#" class="btn btn-sm btn-outline-danger">Löschen</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>